<!DOCTYPE html>
<html lang="en" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/style.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"
    />
    <title><%= titlePage %></title>
  </head>
  <body>
    <!---------------------------------- modal -------------------------------- -->

    <!-- edit course modal-->
    <!-- ! add visible class to be visible ! -->
    <div class="modal-container" id="edit-modal">
      <!-- ! add visible class to be visible ! -->
      <div class="modal-content">
        <!-- ! Edit Course  ! -->
        <h1 class="modal-title">اطلاعات جدید را وارد کنید</h1>
        <form method="POST" class="edit-user-form" enctype="multipart/form-data">
          <div class="input-field">
            <input type="hidden" id="course-id" name="id">
            <span><i class="fa fa-tag"></i></span>
            <input
              type="text"
              id="course-title"
              name="title"
              placeholder="نام دوره"
              spellcheck="false"
            />
          </div>
          <div class="input-field">
            <span><i class="fa fa-cash-register"></i></span>
            <input
              type="text"
              id="course-price"
              name="price"
              placeholder="قیمت دوره"
              spellcheck="false"
            />
          </div>
          <div class="input-field">
            <span><i class="fa fa-user"></i></span>
            <input
              type="text"
              id="course-teacher"
              name="teacherName"
              placeholder="مدرس دوره"
              spellcheck="false"
            />
          </div>
            <div class="input-field">
            <span><i class="fa fa-user"></i></span>
            <input
              type="file"
              id="image"
              name="image"
              placeholder="عکس دوره"
              spellcheck="false"
            />
          </div>
          <button type="submit" class="update-btn btn">اپدیت دوره</button>
        </form>
      </div>
    </div>
  
    <!-- add new course modal-->
    <!-- ! add visible class to be visible ! -->
    <div class="modal-container" id="add-new-course-modal">
      <div class="modal-content">
        <!-- ! Edit Course  ! -->
        <h1 class="modal-title">اضافه کردن دوره جدید</h1>
        <form action="/courses" class="edit-user-form" method="post" enctype="multipart/form-data">
          <div class="input-field">
            <span><i class="fa fa-tag"></i></span>
            <input
              type="text"
              id=""
              name="title"
              class="new-course-title"
              placeholder="نام دوره"
              spellcheck="false"
            />
          </div>
                    <div class="input-field">
            <span><i class="fa fa-tag"></i></span>
            <input
              type="text"
              id=""
              name="price"
              class="new-course-title"
              placeholder="قیمت دوره"
              spellcheck="false"
            />
          </div>
                    <div class="input-field">
            <span><i class="fa fa-tag"></i></span>
            <input
              type="text"
              id=""
              name="teacherName"
              class="new-course-title"
              placeholder="مدرس"
              spellcheck="false"
            />
          </div>
            <div class="input-field">
            <span><i class="fa fa-user"></i></span>
            <input
              type="file"
              id="image"
              name="image"
              placeholder="عکس دوره"
              spellcheck="false"
            />
          </div>
          <button type="submit" class="add-course-btn update-btn btn">
            ایجاد دوره
          </button>
        </form>
      </div>
    </div>
    <!----------------------------------End modal -------------------------------- -->

    <!-- add new course modal-->


    <div class="container">
      <!-- Sidebar -->
      <aside class="sidebar">
        <div class="sidebar-logo">
          <img src="/images/logo/logo.png" alt="" />
          <h3>Academy
          </h3>
        </div>
        <ul class="sidebar-links">
          <li>
            <a href="#" class="active sidebar-link">
              <!-- add active to enable link -->
              <span>
                <i class="fa fa-home"></i>
              </span>
              صفحه اصلی
            </a>
          </li>

          <li>
            <a href="#" class="sidebar-link">
              <span>
                <i class="fa fa-book-bookmark"></i>
              </span>
              درباره ما
            </a>
          </li>
          <li>
            <a href="/cart" class="sidebar-link">
              <span>
                <i class="fa fa-book-bookmark"></i>
              </span>
              سبد خرید
            </a>
          </li>
          <li>
            <% if(user && user.role === "ADMIN"){ %>

              <a href="/cart/orders">
                  مشاهده سفارشات کاربران
              </a>

            <% } %>
          </li>
        </ul>

        <div class="sidebar-logout">
          <a href="/logout" class="logout">
            <span>
              <i class="fa fa-lock"></i>
            </span>
            خروج
          </a>
        </div>
      </aside>
      <!-- End Sidebar -->

      <main class="main">
        <!-- Navbar -->
        <nav class="navbar">
          <div class="navbar-search">
            <input type="text" name="" id="search-input" placeholder="جستجو کنید...." />
            <span class="navbar-search-icon">
              <i class="fa fa-search"></i>
            </span>
          </div>
          <div class="navbar-user-avatar">
            <img src="/images/avatar/avatar.png" alt="" />
          </div>
        </nav>
        <!-- End Navbar -->

        <!-- Courses -->
        <section class="courses">
          <div class="courses-top">
            <h2 class="courses-title">دوره ها</h2>

            <% if(messages.error && messages.error.length > 0){ %>
              <div class="alert-error">
                <ul>
                  <% messages.error.forEach(error => { %>
                    <li><%= error %></li>
                  
                  <% }) %>
                </ul>
              </div>
            <% } %>

            <% if(messages.success){ %>

              <% messages.success.forEach(success => { %>
                <div class="alert-success">
                  <%= success %>
                </div>
              <% }) %>

            <% } %>

            <% if (user && user.role === "ADMIN") { %>
              <a href="#" class="btn courses-btn-add-new-course">
               اضافه کردن دوره جدید
              </a>
            <% } %>
          </div>

          <ul class="courses-list" id="courses-list">
    <% courses.forEach(function(course) { %>

    <li class="courses-item">

        <div class="courses-img-title">
            <img src="/uploads/<%= course.image %>" class="courses-img">
            <div class="course-info">
              
            <h5 class="courses-name">نام دوره :  <%= course.title %></h5>
            
            <h5 class="courses-name">   قیمت :    <%= course.price %></h5>
            
            <h5 class="courses-name">   نام مدرس : <%= course.teacherName %></h5>
            </div>
            
        </div>
        <% if (user && user.role === "USER") { %>
            <a href="/cart/add/<%= course._id %>" class="btn">سفارش</a>
          <% } %>
        <% if (user && user.role === "ADMIN") { %>

        <div class="courses-btns">
          
            <a href="#"
               class="courses-btn-edit btn"
               onclick="openEditModal('<%= course._id %>', '<%= course.title %>', '<%= course.price %>', '<%= course.teacherName %>'); return false;">
                ویرایش
            </a>

            <a href="/courses/remove/<%= course._id %>"
               class="courses-btn-delete btn">
                حذف
            </a>
        </div>

        <% } %>

    </li>

    <% }) %>
</ul>
           <!-- Courses List -->
        </section>
         <!-- End Courses -->
      </main>
    </div>
    
<script>
    window.currentUser = <%- JSON.stringify(user || null) %>;
</script>
    <script src="/js/app.js"></script>
  </body>
</html>
